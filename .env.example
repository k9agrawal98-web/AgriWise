# Copy to .env or set these in the shell. Environment variables take precedence.
AGRIWISE_SECRET_KEY=replace-with-a-long-random-secret
DATA_GOV_IN_API_KEY=
# Optional local override. Vercel defaults to /tmp/agriwise.
# AGRIWISE_DATA_DIR=/tmp/agriwise
# For durable hosted farmer data, set this to a mounted persistent disk path.
# AGRIWISE_ENV=production
# AGRIWISE_SECURE_COOKIES=true
